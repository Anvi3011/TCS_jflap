<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>grammar</type>
	<!--The list of productions.-->
	<production>
		<left>S</left>
		<right>aA</right>
	</production>
	<production>
		<left>S</left>
		<right>bS</right>
	</production>
	<production>
		<left>A</left>
		<right>aA</right>
	</production>
	<production>
		<left>A</left>
		<right>bB</right>
	</production>
	<production>
		<left>B</left>
		<right>aA</right>
	</production>
	<production>
		<left>B</left>
		<right>bS</right>
	</production>
	<production>
		<left>B</left>
		<right></right>
	</production>
</structure>